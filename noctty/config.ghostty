# Noctty (Windows, Ghostty core). Source of truth: ~/dotfiles/noctty/config.ghostty,
# symlinked to %LOCALAPPDATA%\noctty\config.ghostty by bootstrap/symlink.sh (WSL only).
# Based on ../ghostty/config; dropped macos-titlebar-style, window-decoration = server,
# and the config.local include (WSL font-size override inlined).

# Open the WSL distro in new tabs/windows
default-profile = wsl:Ubuntu-26.04

font-family = "CommitMono"
font-size = 14
adjust-cell-height = 50%

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
font-thicken = true
font-thicken-strength = 2

font-feature = -calt
font-feature = -liga
font-feature = -dlig

font-codepoint-map = U+F101-U+F27D=nonicons

# background = #131313
background = #0a0a0a
foreground = #b4b4b4

palette = 0=#212121
palette = 1=#ff8185
palette = 2=#81ffbb
palette = 3=#ffd6b3
palette = 4=#93c5fd
palette = 5=#818cf8
palette = 6=#97CCF1
palette = 7=#d5d5d5

palette = 8=#555555
palette = 9=#ff8185
palette = 10=#81ffbb
palette = 11=#ffd6b3
palette = 12=#93c5fd
palette = 13=#818cf8
palette = 14=#678CB1
palette = 15=#989898

cursor-style-blink = false
mouse-hide-while-typing = true
confirm-close-surface = false
bold-is-bright = true

# OSC 9/777 desktop notifications from TUIs (e.g. Claude Code)
desktop-notifications = true

# Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# No tabs: hide the tab bar and remove the only default key that opens a tab
window-show-tab-bar = never
keybind = ctrl+shift+t=unbind

# tmux prefix is C-i. Noctty sends Ctrl+I as a plain Tab (0x09), which tmux
# (extended-keys on) does not treat as C-i. Send the CSI-u form instead.
keybind = ctrl+i=csi:105;5u
